# Ejecutar todas las peticiones en orden desde IntelliJ HTTP Client.
# Iniciar con H2 vacía; reiniciar esta aplicación para repetir el recorrido:
# ./mvnw spring-boot:run -Dspring-boot.run.arguments="--spring.datasource.url=jdbc:h2:mem:pruebas-http --spring.jpa.hibernate.ddl-auto=create-drop"
# Los ids y el mes de entrega se toman de las respuestas.

@base = http://localhost:8080/api
@inexistente = 999999

### Vehículos sin datos (200)
GET {{base}}/vehiculos

> {%
client.test("Vehículos sin datos", function () {
    client.assert(response.status === 200, "Se esperaba HTTP 200");
    client.assert(Array.isArray(response.body) && response.body.length === 0, "Lista vacía");
});
%}

### Órdenes sin datos (200)
GET {{base}}/ordenes

> {%
client.test("Órdenes sin datos", function () {
    client.assert(response.status === 200, "Se esperaba HTTP 200");
    client.assert(Array.isArray(response.body) && response.body.length === 0, "Lista vacía");
});
%}

### Repuestos sin datos (200)
GET {{base}}/repuestos

> {%
client.test("Repuestos sin datos", function () {
    client.assert(response.status === 200, "Se esperaba HTTP 200");
    client.assert(Array.isArray(response.body) && response.body.length === 0, "Lista vacía");
});
%}

### Crear cliente (201)
POST {{base}}/clientes
Content-Type: application/json

{"nombre":"Carlos Ruiz","telefono":"3825123456"}

> {%
client.test("Crear cliente", function () {
    client.assert(response.status === 201, "Se esperaba HTTP 201");
    client.assert(typeof response.body.id === "number", "Id generado");
    client.assert(response.headers.valueOf("Location") === "/api/clientes/" + response.body.id, "Location del recurso creado");
    client.global.set("clienteId", response.body.id.toString());
});
%}

### Crear otro cliente (201)
POST {{base}}/clientes
Content-Type: application/json

{"nombre":"Ana Díaz","telefono":"3825000000"}

> {%
client.test("Crear otro cliente", function () {
    client.assert(response.status === 201, "Se esperaba HTTP 201");
    client.assert(typeof response.body.id === "number", "Id generado");
    client.assert(response.headers.valueOf("Location") === "/api/clientes/" + response.body.id, "Location del recurso creado");
    client.global.set("otroClienteId", response.body.id.toString());
});
%}

### Cliente con campos vacíos (400)
POST {{base}}/clientes
Content-Type: application/json

{"nombre":"","telefono":""}

> {%
client.test("Cliente con campos vacíos", function () {
    client.assert(response.status === 400, "Se esperaba HTTP 400");
    client.assert(response.contentType.mimeType === "application/problem+json", "Formato de error");
    client.assert(response.body.status === 400 && response.body.title && response.body.detail, "ProblemDetail completo");
    client.assert(response.body.errores.nombre && response.body.errores.telefono, "Errores por campo");
});
%}

### Cliente con campos ausentes (400)
POST {{base}}/clientes
Content-Type: application/json

{}

> {%
client.test("Cliente con campos ausentes", function () {
    client.assert(response.status === 400, "Se esperaba HTTP 400");
    client.assert(response.contentType.mimeType === "application/problem+json", "Formato de error");
    client.assert(response.body.status === 400 && response.body.title && response.body.detail, "ProblemDetail completo");
    client.assert(response.body.errores.nombre && response.body.errores.telefono, "Campos obligatorios");
});
%}

