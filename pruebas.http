### Crear orden principal (201)
POST {{base}}/ordenes
Content-Type: application/json

{"vehiculoId":{{vehiculoId}},"descripcion":"Cambio de aceite"}

> {%
client.test("Crear orden principal", function () {
    client.assert(response.status === 201, "Se esperaba HTTP 201");
    client.assert(typeof response.body.id === "number", "Id generado");
    client.assert(response.headers.valueOf("Location") === "/api/ordenes/" + response.body.id, "Location del recurso creado");
    client.assert(response.body.estado === "INGRESADO" && response.body.vehiculoId === Number(client.global.get("vehiculoId")), "Estado inicial y vehículo");
    client.assert(typeof response.body.fechaIngreso === "string", "Fecha de ingreso");
    client.global.set("mesIngreso", response.body.fechaIngreso.substring(0, 7));
    client.global.set("ordenId", response.body.id.toString());
});
%}

