### Terminar reparación y calcular horas (200)
PATCH {{base}}/ordenes/{{ordenId}}/estado
Content-Type: application/json

{"estado":"TERMINADO"}

> {%
client.test("Terminar reparación y calcular horas", function () {
    client.assert(response.status === 200, "Se esperaba HTTP 200");
    client.assert(response.body.estado === "TERMINADO" && response.body.costoRepuestos === 29753, "Orden terminada");
    client.assert(typeof response.body.horasEnReparacion === "number" && response.body.horasEnReparacion >= 0, "Horas calculadas sin esperas");
    client.assert(response.body.fechaInicioReparacion === client.global.get("fechaInicioReparacion"), "Inicio conservado");
    client.global.set("fechaTerminacion", response.body.fechaTerminacion);
    client.global.set("horasReparacion", response.body.horasEnReparacion.toString());
});
%}

