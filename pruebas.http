### Entregar y conservar horas de reparación (200)
PATCH {{base}}/ordenes/{{ordenId}}/estado
Content-Type: application/json

{"estado":"ENTREGADO"}

> {%
client.test("Entregar y conservar horas de reparación", function () {
    client.assert(response.status === 200, "Se esperaba HTTP 200");
    client.assert(response.body.estado === "ENTREGADO" && response.body.costoFinal === 45000.75, "Entrega con costo");
    client.assert(response.body.horasEnReparacion === Number(client.global.get("horasReparacion")), "Horas conservadas al entregar");
    client.assert(response.body.fechaInicioReparacion === client.global.get("fechaInicioReparacion") && response.body.fechaTerminacion === client.global.get("fechaTerminacion"), "Fechas conservadas");
    client.global.set("mesEntrega", response.body.fechaEntrega.substring(0, 7));
});
%}

