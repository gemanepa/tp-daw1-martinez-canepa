### Los rechazos conservaron las órdenes y sus estados (200)
GET {{base}}/ordenes

> {%
client.test("Los rechazos conservaron las órdenes y sus estados", function () {
    client.assert(response.status === 200, "Se esperaba HTTP 200");
    client.assert(response.body.length === 4, "Cuatro órdenes guardadas");
    client.assert(response.body.find(o => o.id === Number(client.global.get("ordenId"))).estado === "ENTREGADO", "Entrega conservada");
    client.assert(response.body.find(o => o.id === Number(client.global.get("segundaOrdenId"))).estado === "CANCELADO", "Cancelación conservada");
    client.assert(response.body.find(o => o.id === Number(client.global.get("terceraOrdenId"))).estado === "INGRESADO", "Nueva orden abierta");
});
