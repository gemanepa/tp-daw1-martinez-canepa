### Cliente sin vehículos (200)
GET {{base}}/clientes/{{otroClienteId}}/vehiculos

> {%
client.test("Cliente sin vehículos", function () {
    client.assert(response.status === 200, "Se esperaba HTTP 200");
    client.assert(Array.isArray(response.body) && response.body.length === 0, "Lista vacía");
});
%}

### Crear vehículo ABC123 (201)
POST {{base}}/vehiculos
Content-Type: application/json

{"patente":"ABC123","marca":"Fiat","modelo":"Cronos","clienteId":{{clienteId}}}

> {%
client.test("Crear vehículo ABC123", function () {
    client.assert(response.status === 201, "Se esperaba HTTP 201");
    client.assert(typeof response.body.id === "number", "Id generado");
    client.assert(response.headers.valueOf("Location") === "/api/vehiculos/" + response.body.id, "Location del recurso creado");
    client.assert(response.body.clienteId === Number(client.global.get("clienteId")), "Relación con cliente");
    client.global.set("vehiculoId", response.body.id.toString());
});
%}

### Crear vehículo AB123CD de otro cliente (201)
POST {{base}}/vehiculos
Content-Type: application/json

{"patente":"AB123CD","marca":"VW","modelo":"Gol","clienteId":{{otroClienteId}}}

> {%
client.test("Crear vehículo AB123CD de otro cliente", function () {
    client.assert(response.status === 201, "Se esperaba HTTP 201");
    client.assert(typeof response.body.id === "number", "Id generado");
    client.assert(response.headers.valueOf("Location") === "/api/vehiculos/" + response.body.id, "Location del recurso creado");
    client.global.set("otroVehiculoId", response.body.id.toString());
});
%}

### Listar vehículos guardados (200)
GET {{base}}/vehiculos

> {%
client.test("Listar vehículos guardados", function () {
    client.assert(response.status === 200, "Se esperaba HTTP 200");
    client.assert(Array.isArray(response.body) && response.body.length === 2, "Dos vehículos");
});
%}

### Consultar vehículo por id (200)
GET {{base}}/vehiculos/{{vehiculoId}}

> {%
client.test("Consultar vehículo por id", function () {
    client.assert(response.status === 200, "Se esperaba HTTP 200");
    client.assert(response.body.patente === "ABC123" && response.body.id === Number(client.global.get("vehiculoId")), "Vehículo guardado");
});
%}

### Actualizar conservando la propia patente (200)
PUT {{base}}/vehiculos/{{vehiculoId}}
Content-Type: application/json

{"patente":"ABC123","marca":"Fiat","modelo":"Cronos 1.3","clienteId":{{clienteId}}}

> {%
client.test("Actualizar conservando la propia patente", function () {
    client.assert(response.status === 200, "Se esperaba HTTP 200");
    client.assert(response.body.id === Number(client.global.get("vehiculoId")) && response.body.modelo === "Cronos 1.3", "Id conservado y modelo actualizado");
});
%}

### Vehículo con datos inválidos (400)
POST {{base}}/vehiculos
Content-Type: application/json

{"patente":"123","marca":"","modelo":"","clienteId":null}

> {%
client.test("Vehículo con datos inválidos", function () {
    client.assert(response.status === 400, "Se esperaba HTTP 400");
    client.assert(response.contentType.mimeType === "application/problem+json", "Formato de error");
    client.assert(response.body.status === 400 && response.body.title && response.body.detail, "ProblemDetail completo");
    client.assert(response.body.errores.patente && response.body.errores.marca && response.body.errores.modelo && response.body.errores.clienteId, "Validaciones del vehículo");
});
%}

